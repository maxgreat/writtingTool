{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "core:app:allow-exit",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://maxgreat.github.io/writtingTool/*" }] }
  ]
}
