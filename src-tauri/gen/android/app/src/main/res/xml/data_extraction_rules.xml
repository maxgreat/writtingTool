<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The Dropbox sign-in is a credential for this
     device: it stays out of backups and transfers to a new phone, which
     connects again. Everything else is kept as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="dropbox-token" />
        <exclude domain="root" path="dropbox.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="dropbox-token" />
        <exclude domain="root" path="dropbox.json" />
    </device-transfer>
</data-extraction-rules>
